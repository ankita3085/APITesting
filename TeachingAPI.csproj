<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Which .NET version we compile against. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nullable reference types: the compiler warns when something might be null. -->
    <Nullable>enable</Nullable>
    <!-- Implicit usings: common namespaces (System, System.Linq, ...) are imported automatically. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its files out of this project's compilation. -->
    <Compile Remove="TeachingAPI.Tests/**" />
    <Content Remove="TeachingAPI.Tests/**" />
    <None Remove="TeachingAPI.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet packages: JWT validation middleware and OpenAPI document generation. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Pinned to a patched version: the one OpenApi pulls in by default has a known vulnerability. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

</Project>
